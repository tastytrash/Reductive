{
	"schemaVersion": 1,
	"id": "reductive",
	"version": "${version}",
	"name": "reductive",
	"description": "A mod about refining blocks down into smaller parts and crafting them into new resources, tools, and blocks.",
	"authors": [
		"tastytrash"
	],
	"contact": {
		"sources": "https://github.com/tastytrash/Reductive"
	},
	"license": "MIT",
	"icon": "assets/reductive/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.reductive.Reductive"
		],
        "fabric-datagen": [
          "com.reductive.ReductiveDataGenerator"
        ],
		"client": [
			"com.reductive.ReductiveClient",
            "com.reductive.EntityRenderersRegistry"
		]
	},
	"mixins": [
		"reductive.mixins.json",
		{
			"config": "reductive.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"another-mod": "*"
	}
}